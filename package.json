{
  "name": "harness-qa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "sensores:estaticos": "tsx harness/sensores/executar.ts estaticos",
    "sensores:relatorio": "tsx harness/sensores/executar.ts relatorio",
    "sensores:drift": "tsx harness/sensores/executar.ts drift",
    "test:componente": "playwright test --project=componente",
    "test:integracao": "playwright test --project=integracao",
    "test:contrato": "playwright test --project=contrato",
    "test:e2e": "playwright test --project=e2e",
    "test:a11y": "playwright test --project=acessibilidade",
    "cobertura": "c8 playwright test --project=componente",
    "mutacao": "stryker run harness/config/stryker.config.json",
    "matriz": "tsx harness/sensores/matriz.ts",
    "novo-teste": "tsx harness/guias/scaffold/novo-teste.ts",
    "novo-sistema": "tsx harness/guias/scaffold/novo-sistema.ts",
    "servidor:local": "serverest --nodoc --porta 3000",
    "verificar": "npm run typecheck && npm run lint && npm run sensores:estaticos && npm run test:componente"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@stryker-mutator/core": "^8.7.1",
    "@stryker-mutator/typescript-checker": "^8.7.1",
    "@types/node": "^22.0.0",
    "c8": "^10.1.2",
    "eslint": "^9.14.0",
    "eslint-plugin-playwright": "^2.0.0",
    "serverest": "^3.2.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.14.0"
  }
}
